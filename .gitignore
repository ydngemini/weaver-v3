# Secrets only
.env
token.json
credentials.json
ghost_key.json
lost+found/
.pip_cache/

# Large model weights, checkpoints & tokenized data (never push to GitHub)
*.pt
*.bin
*.gguf
*.safetensors
CascadeProjects/3b/
CascadeProjects/windsurf-project/pretrain_moe/kaggle_output/
CascadeProjects/windsurf-project/pretrain_moe/kaggle_prep_output/
CascadeProjects/windsurf-project/pretrain_moe/kaggle_train_output/
CascadeProjects/windsurf-project/pretrain_moe/kaggle_smoke/

# Avatar 3D assets (large binaries; production copies live in the public
# weaver-avatar-404870839825 S3 bucket, not git). embodiment.html itself IS
# tracked — it's the actual page source, small and meaningful to version.
avatar/*.glb
# The deterministic HiFi runtime tier is intentionally versioned so a clean
# checkout can serve and deploy it without depending on workstation state.
!avatar/weaver_avatar_dress_hifi.glb
avatar/*.blend
avatar/*.blend1
avatar/assets/
avatar/**/*.zip
avatar/renders/

# Terraform plan files
*.tfplan
tfplan


# Python / IDE / local-agent cruft
__pycache__/
*.pyc
*.log
.claude/
CascadeProjects/.claude/
CascadeProjects/windsurf-project/Quantum Computing Architecture_files/
