# Secrets only
.env
token.json
credentials.json
ghost_key.json
lost+found/
.pip_cache/

# Large model weights, checkpoints & tokenized data (never push to GitHub)
*.pt
*.bin
*.gguf
*.safetensors
CascadeProjects/3b/
CascadeProjects/windsurf-project/pretrain_moe/kaggle_output/
CascadeProjects/windsurf-project/pretrain_moe/kaggle_prep_output/
CascadeProjects/windsurf-project/pretrain_moe/kaggle_train_output/
CascadeProjects/windsurf-project/pretrain_moe/kaggle_smoke/

# Avatar 3D assets (large binaries; production copies live in the public
# weaver-avatar-404870839825 S3 bucket, not git). embodiment.html itself IS
# tracked — it's the actual page source, small and meaningful to version.
avatar/*.glb
# The deterministic HiFi runtime tier is intentionally versioned so a clean
# checkout can serve and deploy it without depending on workstation state.
!avatar/weaver_avatar_dress_hifi.glb
avatar/*.blend
avatar/*.blend1
avatar/assets/
avatar/**/*.zip
avatar/renders/

# Terraform plan files
*.tfplan
tfplan


# Python / IDE / local-agent cruft
__pycache__/
*.pyc
*.log
.claude/
CascadeProjects/.claude/
CascadeProjects/windsurf-project/Quantum Computing Architecture_files/

# --- Migration hardening (2026-08-27): never publish infra state to a PUBLIC repo ---
# Terraform state holds plaintext credentials (Azure storage primary_access_key).
# Real copies live in ~/.secrets/weaver-v3/ and in the GCS archive, never in git.
terraform.tfstate
terraform.tfstate.*
*.tfstate
*.tfstate.*
terraform.tfvars
!terraform.tfvars.example
.terraform/
.terraform.lock.hcl

# Manim render cache is regenerable from weaver_equations.py.
# The final cut is kept; partial movie files and the text SVG cache are not.
manim/media/texts/
manim/media/videos/**/partial_movie_files/
manim/media/videos/**/480p15/

# deepface downloads its own weights on first use
CascadeProjects/windsurf-project/.deepface/
