# Public TLS reverse proxy for the Weaver full stack (3 origins, 1 box).
#
#   weaverv3.com          the embodied avatar page (avatar/embodiment.html) at the root,
#                         plus gated /brain/* and /llm/* model proxies.
#   headless.weaverv3.com lightweight no-GPU headless Weaver presence backed by
#                         the same unified AWS Bedrock brain service.
#   dash.weaverv3.com     weaver_dashboard.py (127.0.0.1:9990) — full read/write control
#                         plane, can trigger real Twilio calls via /api/call. MUST stay
#                         behind basic_auth.
#   status.weaverv3.com   health_dashboard.py (127.0.0.1:9996) — read-only traffic-light
#                         status. Also behind basic_auth for consistency.
#
# weaver_dashboard.py and health_dashboard.py both use root-relative fetch paths
# internally (fetch('/api/state') etc.) — they assume they own the whole origin, so
# each gets its OWN subdomain rather than a Caddy subpath. A subpath (e.g. /dash/*)
# would break their client JS: it would fetch the sibling API at the domain root
# instead of under the subpath.
#
# WEAVER_LLM_KEY and WEAVER_DASH_HASH are set via the systemd EnvironmentFile
# (/etc/default/caddy, written by setup_oracle_extras.sh alongside ORACLE_HOST).
# Regenerate the basic-auth hash with `caddy hash-password`.
#
# llama.cpp's OpenAI-compatible server (port 8090) ships with ZERO auth unless you
# pass --api_key — the @denied header-matcher below is the ONLY thing standing
# between this box's free LLM inference and the public internet. Do not remove it.
#
# Oracle previously lived at the domain root here — it's been moved off entirely
# (it's "neoh", branded and hosted separately at neoh.app; this box's copy was a
# leftover dev instance, DB never wired up). oracle-backend.service may still be
# running unrouted; stop it if you don't need it anymore.
#
# Ports 80 + 443 must be open in the Security Group (already done by Terraform) —
# nothing else to open, AWS Ubuntu AMIs ship with no default iptables REJECT.

weaverv3.com {
	encode zstd gzip

	handle_path /llm/* {
		@denied {
			not header X-Weaver-Key {$WEAVER_LLM_KEY}
		}
		respond @denied 403
		reverse_proxy 127.0.0.1:8090
	}

	# Native browser WebSockets cannot attach X-Weaver-Key. The realtime voice
	# endpoint authenticates its WebSocket subprotocol token inside bedrock_brain_api.py.
	handle /brain/realtime/* {
		uri strip_prefix /brain
		reverse_proxy 127.0.0.1:8093
	}

	# unified AWS Bedrock cortex: weaver-one coordinates speed, dream, code,
	# vision, and main reasoning routes through one OpenAI-compatible endpoint.
	handle_path /brain/* {
		@bdenied {
			not header X-Weaver-Key {$WEAVER_LLM_KEY}
		}
		respond @bdenied 403
		reverse_proxy 127.0.0.1:8093
	}

	# read-only source-code context for Weaver's self-inspection. Same key gate as /llm.
	handle_path /codebase/* {
		@cdenied {
			not header X-Weaver-Key {$WEAVER_LLM_KEY}
		}
		respond @cdenied 403
		reverse_proxy 127.0.0.1:8091
	}

	# her voice — AWS Polly generative TTS behind the local tts_server.py
	# (127.0.0.1:8092), with browser speech fallback if synthesis fails.
	handle_path /tts/* {
		@tdenied {
			not header X-Weaver-Key {$WEAVER_LLM_KEY}
		}
		respond @tdenied 403
		reverse_proxy 127.0.0.1:8092
	}

	# heavy remote GPU splat renderer. This is visual-only and intentionally not
	# key-gated so <img src="/gpu-render/stream.mjpg"> can render without custom
	# headers; if the pod is down the page falls back to the local lite scene.
	handle_path /gpu-render/* {
		reverse_proxy https://arl906d9mi8tpd-8888.proxy.runpod.net {
			header_up Host arl906d9mi8tpd-8888.proxy.runpod.net
		}
	}

	handle {
		root * /var/www/weaver
		file_server
	}
}

headless.weaverv3.com {
	encode zstd gzip

	handle /brain/realtime/* {
		uri strip_prefix /brain
		reverse_proxy 127.0.0.1:8093
	}

	handle_path /brain/* {
		@hbdenied {
			not header X-Weaver-Key {$WEAVER_LLM_KEY}
		}
		respond @hbdenied 403
		reverse_proxy 127.0.0.1:8093
	}

	handle_path /tts/* {
		@htdenied {
			not header X-Weaver-Key {$WEAVER_LLM_KEY}
		}
		respond @htdenied 403
		reverse_proxy 127.0.0.1:8092
	}

	handle_path /codebase/* {
		@hcdenied {
			not header X-Weaver-Key {$WEAVER_LLM_KEY}
		}
		respond @hcdenied 403
		reverse_proxy 127.0.0.1:8091
	}

	handle {
		root * /var/www/weaver-headless
		file_server
	}
}

dash.weaverv3.com {
	basic_auth {
		ydnop {$WEAVER_DASH_HASH}
	}
	reverse_proxy 127.0.0.1:9990
}

status.weaverv3.com {
	basic_auth {
		ydnop {$WEAVER_DASH_HASH}
	}
	reverse_proxy 127.0.0.1:9996
}
