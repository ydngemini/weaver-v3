# Public TLS reverse proxy for the Weaver full stack (3 origins, 1 box).
#
#   weaverv3.com          the embodied avatar page (avatar/embodiment.html) at the root,
#                         plus a gated /llm/* proxy to the on-box llama.cpp server.
#   dash.weaverv3.com     weaver_dashboard.py (127.0.0.1:9990) — full read/write control
#                         plane, can trigger real Twilio calls via /api/call. MUST stay
#                         behind basic_auth.
#   status.weaverv3.com   health_dashboard.py (127.0.0.1:9996) — read-only traffic-light
#                         status. Also behind basic_auth for consistency.
#
# weaver_dashboard.py and health_dashboard.py both use root-relative fetch paths
# internally (fetch('/api/state') etc.) — they assume they own the whole origin, so
# each gets its OWN subdomain rather than a Caddy subpath. A subpath (e.g. /dash/*)
# would break their client JS: it would fetch the sibling API at the domain root
# instead of under the subpath.
#
# WEAVER_LLM_KEY and WEAVER_DASH_HASH are set via the systemd EnvironmentFile
# (/etc/default/caddy, written by setup_oracle_extras.sh alongside ORACLE_HOST).
# Regenerate the basic-auth hash with `caddy hash-password`.
#
# llama.cpp's OpenAI-compatible server (port 8090) ships with ZERO auth unless you
# pass --api_key — the @denied header-matcher below is the ONLY thing standing
# between this box's free LLM inference and the public internet. Do not remove it.
#
# Oracle previously lived at the domain root here — it's been moved off entirely
# (it's "neoh", branded and hosted separately at neoh.app; this box's copy was a
# leftover dev instance, DB never wired up). oracle-backend.service may still be
# running unrouted; stop it if you don't need it anymore.
#
# Ports 80 + 443 must be open in the Security Group (already done by Terraform) —
# nothing else to open, AWS Ubuntu AMIs ship with no default iptables REJECT.

weaverv3.com {
	encode zstd gzip

	handle_path /llm/* {
		@denied not header X-Weaver-Key {$WEAVER_LLM_KEY}
		respond @denied 403
		reverse_proxy 127.0.0.1:8090
	}

	# her cloned voice — XTTS-v2 on a RunPod RTX 4090 (deploy/tts/, ~0.9s GPU synth).
	# Proxied to the pod's public RunPod URL; the pod ALSO checks X-Weaver-Key
	# (the proxy URL is public), so the gate is enforced at both hops. If the pod
	# is down, this 502s and the page falls back to the browser voice on its own.
	# Local CPU OpenVoice on :8092 stays installed as a manual fallback (swap the
	# reverse_proxy line back to 127.0.0.1:8092).
	handle_path /tts/* {
		@tdenied not header X-Weaver-Key {$WEAVER_LLM_KEY}
		respond @tdenied 403
		reverse_proxy https://f6t7m2t1errly1-8888.proxy.runpod.net {
			header_up Host f6t7m2t1errly1-8888.proxy.runpod.net
		}
	}

	handle {
		root * /var/www/weaver
		file_server
	}
}

dash.weaverv3.com {
	basicauth {
		weaver {$WEAVER_DASH_HASH}
	}
	reverse_proxy 127.0.0.1:9990
}

status.weaverv3.com {
	basicauth {
		weaver {$WEAVER_DASH_HASH}
	}
	reverse_proxy 127.0.0.1:9996
}
