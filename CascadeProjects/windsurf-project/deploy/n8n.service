[Unit]
Description=Weaver n8n workflow container
Requires=docker.service
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f n8n
ExecStart=/usr/bin/docker run --name n8n --restart=no \
	--init \
  --network host \
  --add-host host.docker.internal:127.0.0.1 \
  --read-only \
  --tmpfs /tmp:rw,noexec,nosuid,nodev,size=256m \
  --tmpfs /home/node/.cache:rw,noexec,nosuid,nodev,size=128m \
  --cap-drop ALL \
  --security-opt no-new-privileges:true \
  --pids-limit 512 \
  --ulimit nofile=65536:65536 \
  --memory 2g \
  --memory-reservation 1536m \
  --memory-swap 2g \
  --cpus 2 \
  --log-driver local \
  --log-opt max-size=10m \
  --log-opt max-file=3 \
  -v n8n_data:/home/node/.n8n \
  -e N8N_HOST=127.0.0.1 \
  -e N8N_LISTEN_ADDRESS=127.0.0.1 \
  -e N8N_PORT=5678 \
  -e N8N_RUNNERS_BROKER_PORT=5680 \
  -e N8N_RUNNERS_ENABLED=true \
  -e N8N_RUNNERS_MODE=internal \
  -e N8N_RUNNERS_BROKER_LISTEN_ADDRESS=127.0.0.1 \
  -e N8N_RUNNERS_MAX_CONCURRENCY=5 \
  -e N8N_RUNNERS_MAX_PAYLOAD=16777216 \
  -e N8N_RUNNERS_MAX_OLD_SPACE_SIZE=512 \
  -e N8N_RUNNERS_TASK_TIMEOUT=120 \
  -e N8N_RUNNERS_TASK_REQUEST_TIMEOUT=30 \
  -e N8N_RUNNERS_HEARTBEAT_INTERVAL=30 \
  -e N8N_RUNNERS_INSECURE_MODE=false \
  -e N8N_BLOCK_RUNNER_ENV_ACCESS=true \
  -e N8N_BLOCK_ENV_ACCESS_IN_NODE=true \
  -e N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES=true \
  -e N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true \
  -e N8N_COMMUNITY_PACKAGES_ENABLED=false \
  -e N8N_UNVERIFIED_PACKAGES_ENABLED=false \
  -e N8N_VERIFIED_PACKAGES_ENABLED=false \
  -e N8N_PYTHON_ENABLED=false \
  -e N8N_DISABLE_UI=true \
  -e N8N_TEMPLATES_ENABLED=false \
  -e N8N_PERSONALIZATION_ENABLED=false \
  -e N8N_HIRING_BANNER_ENABLED=false \
  -e N8N_VERSION_NOTIFICATIONS_ENABLED=false \
  -e N8N_PUBLIC_API_DISABLED=true \
  -e N8N_PUBLIC_API_SWAGGERUI_DISABLED=true \
  -e N8N_DIAGNOSTICS_ENABLED=false \
  -e N8N_PAYLOAD_SIZE_MAX=1 \
  -e N8N_FORMDATA_FILE_SIZE_MAX=1 \
  -e N8N_METRICS=false \
  -e EXECUTIONS_TIMEOUT=115 \
  -e EXECUTIONS_TIMEOUT_MAX=115 \
  -e EXECUTIONS_DATA_SAVE_ON_ERROR=none \
  -e EXECUTIONS_DATA_SAVE_ON_SUCCESS=none \
  -e EXECUTIONS_DATA_SAVE_ON_PROGRESS=false \
  -e EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=false \
  -e EXECUTIONS_DATA_PRUNE=true \
  -e EXECUTIONS_DATA_MAX_AGE=24 \
  -e EXECUTIONS_DATA_PRUNE_MAX_COUNT=100 \
  -e N8N_CONCURRENCY_PRODUCTION_LIMIT=4 \
  -e N8N_GRACEFUL_SHUTDOWN_TIMEOUT=125 \
  -e N8N_SECURE_COOKIE=false \
  -e GENERIC_TIMEZONE=America/New_York \
  docker.n8n.io/n8nio/n8n:2.25.7@sha256:761374d4eb841b0a22771d6bd68f0e8d827b4979ae4e490045517b13fc1259dd
ExecStop=/usr/bin/docker stop -t 130 n8n
ExecStopPost=-/usr/bin/docker rm -f n8n
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=150
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
