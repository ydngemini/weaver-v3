# ─────────────────────────────────────────────────────────────────
# Weaver — Oracle ARM (Always Free A1) environment
# Copy to  .env  on the cloud box and fill in the blanks.
# ─────────────────────────────────────────────────────────────────

# ── Cost-free LLM routing ────────────────────────────────────────
# Experts backend: "local" (llama.cpp on this box via weaver-llm.service, $0, no
# quota) or "gemini" (free tier, snappier, offloads CPU). This box runs LOCAL.
WEAVER_PUBLIC_URL=https://weaverv3.com
WEAVER_HEADLESS_URL=https://headless.weaverv3.com
WEAVER_DASH_URL=https://dash.weaverv3.com
WEAVER_STATUS_URL=https://status.weaverv3.com
WEAVER_VAULT_DIR=/home/ubuntu/weaver/CascadeProjects/windsurf-project/Nexus_Vault
WEAVER_LLM_BACKEND=local
WEAVER_LLM_MODEL=weaver-local                  # must match weaver-llm.service --model_alias
WEAVER_LOCAL_LLM_URL=http://127.0.0.1:8090/v1  # served by weaver-llm.service
WEAVER_LOCAL_LLM_KEY=local

# To use Gemini instead (faster, ~15 req/min free): set
#   WEAVER_LLM_BACKEND=gemini  /  WEAVER_LLM_MODEL=gemini-2.0-flash  /  GEMINI_API_KEY=<key>
GEMINI_API_KEY=                     # https://aistudio.google.com/apikey  (free)

# ── Soul Voice (LoRA) via GGUF on ARM ────────────────────────────
WEAVER_LORA_BACKEND=gguf
WEAVER_SOUL_GGUF=/home/ubuntu/weaver/CascadeProjects/windsurf-project/weaver_merged_1B_Q4_K_M.gguf
WEAVER_LORA_THREADS=4

# ── Browser voice out: AWS Polly, no OpenAI ──────────────────────
# Requires the instance role/user to allow polly:SynthesizeSpeech.
# Use TTS_PROVIDER=openvoice for the older local cloned voice instead.
TTS_PROVIDER=polly
TTS_FALLBACK_PROVIDER=none
TTS_AWS_REGION=us-east-1
TTS_POLLY_ENGINE=generative
TTS_POLLY_VOICE=Ruth
TTS_POLLY_OUTPUT_FORMAT=mp3

# ── Realtime voice-to-voice: AWS Nova Sonic via /brain/realtime/voice ──────
# Requires Bedrock model access plus bedrock:InvokeModelWithBidirectionalStream.
WEAVER_VOICE_MODEL=amazon.nova-2-sonic-v1:0
WEAVER_VOICE_REGION=us-east-1
WEAVER_VOICE_ID=tiffany
WEAVER_VOICE_REALTIME_MODE=aws

# ── Quantum (free) ───────────────────────────────────────────────
IBM_QUANTUM_TOKEN=                  # https://quantum.ibm.com  (free open plan)
QISKIT_USE_RUST=1

# ── Nexus Bus ────────────────────────────────────────────────────
NEXUS_BUS_URL=ws://127.0.0.1:9999

# ── Unused on headless cloud (VTV / Twilio / Discord need hardware/paid) ──
# Leave blank; those lobes self-disable on import/credential failure.
WEAVER_VOICE_KEY=
WEAVER_MEM_KEY=
WEAVER_VISION_KEY=
