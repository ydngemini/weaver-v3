# ─────────────────────────────────────────────────────────────────
# Weaver — Oracle ARM (Always Free A1) environment
# Copy to  .env  on the cloud box and fill in the blanks.
# ─────────────────────────────────────────────────────────────────

# ── Cost-free LLM routing ────────────────────────────────────────
# Experts backend: "gemini" (free tier, offloads CPU) or "local" (llama.cpp on box, $0, no quota)
WEAVER_LLM_BACKEND=gemini
WEAVER_LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=                     # https://aistudio.google.com/apikey  (free)

# If you prefer fully-local experts instead of Gemini, set:
#   WEAVER_LLM_BACKEND=local
#   WEAVER_LOCAL_LLM_URL=http://127.0.0.1:8090/v1   (a llama.cpp --server you run)

# ── Soul Voice (LoRA) via GGUF on ARM ────────────────────────────
WEAVER_LORA_BACKEND=gguf
WEAVER_SOUL_GGUF=/home/ubuntu/weaver/CascadeProjects/windsurf-project/weaver_merged_1B_Q4_K_M.gguf
WEAVER_LORA_THREADS=4

# ── Quantum (free) ───────────────────────────────────────────────
IBM_QUANTUM_TOKEN=                  # https://quantum.ibm.com  (free open plan)
QISKIT_USE_RUST=1

# ── Nexus Bus ────────────────────────────────────────────────────
NEXUS_BUS_URL=ws://localhost:9999

# ── Unused on headless cloud (VTV / Twilio / Discord need hardware/paid) ──
# Leave blank; those lobes self-disable on import/credential failure.
WEAVER_VOICE_KEY=
WEAVER_MEM_KEY=
WEAVER_VISION_KEY=
