[Unit]
Description=Weaver v4 headless full stack (Nexus Bus, Quantum Soul, Pineal Gate, Experts, Soul Voice)
# Experts run on the local llama.cpp server (weaver-llm.service); start it first.
After=network-online.target weaver-llm.service n8n.service weaver-brain.service
Wants=network-online.target weaver-llm.service n8n.service weaver-brain.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
# Adjust if you cloned elsewhere:
WorkingDirectory=/home/ubuntu/weaver/CascadeProjects/windsurf-project
EnvironmentFile=/home/ubuntu/weaver/CascadeProjects/windsurf-project/.env
EnvironmentFile=-/etc/default/caddy
Environment=WEAVER_CODEBASE_ROOT=/home/ubuntu/weaver
Environment=WEAVER_VAULT_DIR=/home/ubuntu/weaver/CascadeProjects/windsurf-project/Nexus_Vault
Environment=N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/weaver-input
Environment=WEAVER_N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/weaver-input
Environment=WEAVER_LORA_BACKEND=gguf
Environment=WEAVER_SOUL_GGUF=/home/ubuntu/weaver/CascadeProjects/windsurf-project/weaver_merged_1B_Q4_K_M.gguf
Environment=WEAVER_LORA_THREADS=4
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/ubuntu/weaver/CascadeProjects/windsurf-project/venv/bin/python3 weaver.py --headless
Restart=on-failure
RestartSec=10
# weaver.py takes ~50s to load all lobes; give it room before health-based restarts.
TimeoutStartSec=120
# Memory guardrail on the 24 GB box (raise if you add the 3B):
MemoryHigh=8G
MemoryMax=10G
KillSignal=SIGTERM
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/weaver/CascadeProjects/windsurf-project/Nexus_Vault -/home/ubuntu/Weaver_Vault
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
LimitNOFILE=65536
TasksMax=1024
CPUQuota=400%
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
