# ─────────────────────────────────────────────────────────────────
# Oracle command-center backend — environment
# Copy to  ~/oracle/backend/.env  on the box and fill in the blanks.
# Read by oracle-backend.service. The backend boots WITHOUT a database
# (demo mode: UI + mock /ws stream); set ORACLE_DB_* only for real persistence.
# ─────────────────────────────────────────────────────────────────

# ── Auth (REQUIRED before public exposure) ───────────────────────
# 64+ random bytes. Generate: openssl rand -hex 48
ORACLE_SECRET_KEY=
# Your single operator login (replaces the disabled hardcoded demo accounts).
ORACLE_ADMIN_ID=
ORACLE_ADMIN_PASSPHRASE=
# Leave demo logins OFF on any internet-facing box (default off). Set to 1 only locally.
ORACLE_ENABLE_DEMO_LOGINS=0

# ── CORS — must include your public origin so the browser can call the API ──
# (Caddy serves SPA + API same-origin, so this is mostly belt-and-suspenders.)
ORACLE_CORS_ORIGINS=https://weaverv3.com,https://headless.weaverv3.com,https://dash.weaverv3.com,https://status.weaverv3.com

# ── Optional persistence (leave blank for demo mode) ─────────────
# ORACLE_DB_HOST=127.0.0.1
# ORACLE_DB_PORT=5432
# ORACLE_DB_NAME=oracle
# ORACLE_DB_USER=postgres
# ORACLE_DB_PASSWORD=
# ORACLE_DB_SSLMODE=disable

# ── Optional integrations (blank = disabled / graceful) ──────────
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
# ORACLE_DEMO_TENANT_ID=default
