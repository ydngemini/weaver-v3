# ═══════════════════════════════════════════════════════════════
# Weaver v3 — Environment Variables (Azure Primary)
# ═══════════════════════════════════════════════════════════════
# Copy to .env and fill in your keys:  cp .env.example .env

# ── Azure OpenAI (primary model backend) ─────────────────────
# Used by: Expert Lobes, Brain API, Voice, Vision
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=https://ydn-mp0oxh6q-eastus2.cognitiveservices.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_NANO_DEPLOYMENT=gpt-4.1-nano

# ── Azure Speech Services (replaces AWS Polly + Nova Sonic) ──
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# ── Weaver LLM Backend ───────────────────────────────────────
WEAVER_LLM_BACKEND=azure
WEAVER_LLM_KEY=
WEAVER_LOCAL_LLM_URL=http://127.0.0.1:8090/v1
WEAVER_LOCAL_LLM_MODEL=weaver-local

# ── Service URLs ─────────────────────────────────────────────
NEXUS_BUS_URL=ws://localhost:9999
N8N_WEBHOOK_URL=http://localhost:5678/webhook/weaver-input
LORA_API_URL=http://localhost:8899/v1/chat/completions
QUANTUM_BIAS_URL=http://localhost:9997/quantum/bias

# ── Port Overrides ───────────────────────────────────────────
# NEXUS_PORT=9999
# QUANTUM_API_PORT=9997
# HEALTH_DASHBOARD_PORT=9996
# TWILIO_BRIDGE_HOST=0.0.0.0
# TWILIO_BRIDGE_PORT=8765

# ── Voice ────────────────────────────────────────────────────
WEAVER_VOICE_REALTIME_MODE=azure
WEAVER_VOICE=shimmer

# ── Azure Storage (avatar assets) ────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=

# ── AWS (legacy fallback — only if using Mantle/Bedrock) ─────
# MANTLE_API_KEY=
# AWS_REGION=us-east-1

# ── Google Gemini (optional, VTV vision) ─────────────────────
# GEMINI_API_KEY=AIza...

# ── IBM Quantum (optional, Quantum Soul) ─────────────────────
# IBM_QUANTUM_TOKEN=...

# ── Twilio Telephony (optional, Phone Bridge) ────────────────
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1...

# ── Proactive Pulse (optional) ───────────────────────────────
# NATE_PHONE_NUMBER=+1...
# PROACTIVE_INTERFERENCE_THRESHOLD=0.85
# DREAM_INTERVAL_HOURS=3

# ── Face Recognition ─────────────────────────────────────────
# DEEPFACE_HOME=~/.deepface

# ── HuggingFace (optional, LoRA download) ────────────────────
# HF_TOKEN=hf_...
