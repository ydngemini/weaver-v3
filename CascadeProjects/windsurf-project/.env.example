# ═══════════════════════════════════════════════════════════════
# Weaver v3 — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy to .env and fill in your keys:  cp .env.example .env

# ── OpenAI (required) ────────────────────────────────────────
# Used by: VTV Core, Phone Bridge, Expert Lobes, Vision
WEAVER_VOICE_KEY=sk-...            # OpenAI Realtime + voice
WEAVER_MEM_KEY=sk-...              # Memory/summarization calls
WEAVER_VISION_KEY=sk-...           # Vision model (gpt-4o)

# ── Google Gemini (optional, VTV vision) ─────────────────────
GEMINI_API_KEY=AIza...

# ── IBM Quantum (optional, Quantum Soul) ─────────────────────
IBM_QUANTUM_TOKEN=...

# ── Twilio Telephony (optional, Phone Bridge) ────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ── Proactive Pulse (optional) ───────────────────────────────
NATE_PHONE_NUMBER=+1...            # Your number for outbound alerts
PROACTIVE_INTERFERENCE_THRESHOLD=0.85
DREAM_INTERVAL_HOURS=3

# ── Service URLs (defaults shown, override for Docker) ───────
NEXUS_BUS_URL=ws://localhost:9999
N8N_WEBHOOK_URL=http://localhost:5678/webhook/weaver-input
LORA_API_URL=http://localhost:8899/v1/chat/completions
QUANTUM_BIAS_URL=http://localhost:9997/quantum/bias

# ── Port Overrides ───────────────────────────────────────────
# NEXUS_PORT=9999
# QUANTUM_API_PORT=9997
# HEALTH_DASHBOARD_PORT=9996
# TWILIO_BRIDGE_HOST=0.0.0.0
# TWILIO_BRIDGE_PORT=8765

# ── Voice ────────────────────────────────────────────────────
WEAVER_VOICE=shimmer               # OpenAI TTS voice: shimmer, alloy, echo, fable, onyx, nova

# ── Face Recognition ─────────────────────────────────────────
DEEPFACE_HOME=~/.deepface

# ── HuggingFace (optional, LoRA download) ────────────────────
# HF_TOKEN=hf_...
